{
  "name": "@copperlineai/release-it-ai-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "release-it plugin: GitHub commits + Vercel AI Gateway for semver bump and changelog",
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "lint": "oxlint . --deny-warnings && oxfmt --check ."
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0"
  },
  "peerDependencies": {
    "release-it": "^19.0.0"
  }
}
