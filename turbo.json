{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "NODE_OPTIONS",
    "TYPESENSE_ADMIN_KEY",
    "NEXT_PUBLIC_TYPESENSE_HOST",
    "NEXT_PUBLIC_TYPESENSE_PORT",
    "NEXT_PUBLIC_TYPESENSE_PROTOCOL",
    "NEXT_PUBLIC_TYPESENSE_SEARCH_KEY",
    "NEXT_PUBLIC_APP_URL",
    "TURBO_*",
    "GITHUB_*",
    "VERCEL_*",
    "RAILWAY_*",
    "BUN_*",
    "SKIP_ENV_VALIDATION"
  ],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["SKIP_ENV_VALIDATION", "NODE_ENV"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": [],
      "cache": true
    },
    "test": {
      "outputs": [],
      "cache": true
    },
    "format": {
      "cache": false
    },
    "format:fix": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
