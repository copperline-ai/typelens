{
  "name": "typesense-dashboard",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@copperlineai/dashboard --filter=@copperlineai/typesense-jobs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "prepare": "husky",
    "start:dashboard": "bun run --cwd apps/dashboard start"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@copperlineai/release-it-ai-gateway": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "release-it": "19.2.4",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc,css}": [
      "oxfmt --write"
    ],
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "oxlint --deny-warnings"
    ]
  },
  "engines": {
    "bun": ">=1.3.12",
    "node": ">=22 <23"
  },
  "packageManager": "bun@1.3.13"
}
