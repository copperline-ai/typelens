# TypeLens — environment variable template
# Copy to .env.local and fill in real values.
# NEVER commit real credentials to source control.

# ── Authentication ───────────────────────────────────────────────────────────
# At least one auth provider must be configured. Both can be active at once.

# Basic auth: username / password login.
# AUTH_PASSWORD doubles as the session-signing secret — use a strong value.
AUTH_USERNAME=admin
AUTH_PASSWORD=

# GitHub OAuth app (optional). Create an OAuth App at
# https://github.com/settings/developers and set the callback URL to
# <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Restrict GitHub logins to specific emails or domains (optional).
# Comma-separated list. Domain entries start with @.
# Examples:
#   AUTH_GITHUB_ALLOWED=alice@example.com,bob@example.com
#   AUTH_GITHUB_ALLOWED=@mycompany.com
#   AUTH_GITHUB_ALLOWED=alice@example.com,@mycompany.com
# Leave unset to allow any authenticated GitHub user.
AUTH_GITHUB_ALLOWED=

# ── Server-side Typesense connection (team deployments) ───────────────────
# Pre-configure the Typesense connection for team deployments.
# Exposed to the browser only via /api/typesense/config — never bundled.
# Leave blank to fall back to in-app Connection Settings (per-browser config).
TYPESENSE_HOST=
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=https

# API key surfaced to the browser via /api/typesense/config.
# Use a search-only key here — NEVER the admin key.
TYPESENSE_API_KEY=

# Optional human-readable name shown in the UI for this server.
TYPESENSE_SERVER_NAME=

# Admin key used by server-side API routes (e.g. JSONL export).
# Required only when server-side write operations are needed.
TYPESENSE_ADMIN_KEY=

# ── App URL ──────────────────────────────────────────────────────────────────
# Canonical URL of this app instance (used for CORS and redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000
