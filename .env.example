# Typesense Dashboard — environment variable template
# Copy to .env.local (Next.js) or .env and fill in real values.
# See README.md § "API Key Security Model" for the two storage modes.
# NEVER commit real API keys to source control.

# ── Server-side (never exposed to the browser) ─────────────────────────────
# Typesense admin key used by Next.js API routes (e.g. JSONL export).
# Required in team/server-proxy deployment mode; leave blank for localStorage mode.
TYPESENSE_ADMIN_KEY=

# ── Public (NEXT_PUBLIC_* — visible in browser bundles) ───────────────────
# Pre-configure the Typesense connection for team deployments.
# Leave blank to use the in-app Connection Settings (localStorage model).
NEXT_PUBLIC_TYPESENSE_HOST=localhost
NEXT_PUBLIC_TYPESENSE_PORT=8108
NEXT_PUBLIC_TYPESENSE_PROTOCOL=http

# Search-only API key for browser use. NEVER put the admin key here.
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=

# Canonical URL of this app instance.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Docker Compose (local dev only) ───────────────────────────────────────
# Admin key for the Typesense container started by docker compose up.
# This value is only used locally; it is never sent to a remote service.
TYPESENSE_API_KEY=local-dev-only-key

# Host path for Typesense data persistence (mounted into the container).
TYPESENSE_DATA_DIR=./typesense-data
