{
  "name": "@copperlineai/typelens-jobs",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "TYPESENSE_DASHBOARD_CONFIG_SLUG=dev INFISICAL_API_URL=https://vault.copperline.io infisical run --project-config-dir=../.. -- trigger dev",
    "dev:local": "trigger dev",
    "deploy": "TYPESENSE_DASHBOARD_CONFIG_SLUG=prod infisical run --project-config-dir=../.. --env prod -- trigger deploy --skip-update-check",
    "deploy:ci": "trigger deploy --skip-update-check",
    "lint": "oxlint . --deny-warnings && oxfmt --check trigger.config.ts \"trigger/**/*.ts\" \"src/**/*.ts\"",
    "format": "oxfmt --check trigger.config.ts \"trigger/**/*.ts\" \"src/**/*.ts\"",
    "format:fix": "oxfmt --write trigger.config.ts \"trigger/**/*.ts\" \"src/**/*.ts\""
  },
  "dependencies": {
    "@trigger.dev/sdk": "4.4.6"
  },
  "devDependencies": {
    "@copperlineai/tsconfig": "workspace:*",
    "@trigger.dev/build": "4.4.6",
    "@types/node": "^22.0.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "trigger.dev": "4.4.6",
    "typescript": "^5.8.3"
  }
}
